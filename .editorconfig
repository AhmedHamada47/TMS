root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cshtml,razor,html,json,yml,yaml}]
indent_size = 2

[*.cs]
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.IDE0008.severity = warning
